{
  "name": "ecom-site",
  "version": "1.0.0",
  "description": "",
  "main": "server.js",
  "scripts": {
    "start": "node server.js/server.js",
    "start:prod": "node --env-file=.env server.js/server.js",
    "build": "node scripts/prepare-production.js",
    "reset-admin": "node scripts/reset-admin.js",
    "show-admin": "node scripts/show-admin.js",
    "change-admin": "powershell -ExecutionPolicy Bypass -File scripts/change-admin.ps1",
    "test:workflows": "node server.js/test-workflows.js",
    "test:workflows:reset": "node -e \"process.env.ENABLE_RESET_TEST='1'; require('./server.js/test-workflows.js')\"",
    "test:platform": "node server.js/test-platform.js",
    "test:pages": "node server.js/test-platform.js",
    "test:audit": "node server.js/test-audit.js",
    "test:e2e": "node server.js/test-e2e-full.js",
    "test:prod": "node server.js/test-prod-regression.js",
    "test:qa": "node server.js/test-platform.js && node server.js/test-audit.js && node server.js/test-workflows.js && node server.js/test-e2e-full.js",
    "purge:ghost-orders": "node scripts/purge-ghost-orders.js",
    "setup:smtp": "node scripts/setup-smtp-settings.js",
    "gmail:preflight": "bash scripts/gmail-oauth-preflight.sh",
    "gmail:set-env": "bash scripts/set-gmail-oauth.sh",
    "tunnel": "node server.js/tunnel.js",
    "migrate:ezyshell": "node scripts/migrate-ezyshell.js",
    "backup:local": "powershell -ExecutionPolicy Bypass -File scripts/backup-local.ps1"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "express": "^5.2.1",
    "express-session": "^1.18.1",
    "nodemailer": "^6.10.1",
    "telegram": "^2.26.22"
  }
}
