# =============================================================================
# Portable ecommerce site — copy to .env on any VPS (chmod 600 .env)
# =============================================================================
# All paths below are OPTIONAL. Defaults work relative to the app folder.
# No hardcoded domains or provider-specific paths required.
# =============================================================================

# --- Runtime ---
NODE_ENV=production
PORT=3001
# Bind all interfaces for external access (http://VPS_IP:3001). Nginx still proxies via 127.0.0.1:3001.
HOST=0.0.0.0

# Public URL shown in logs / used when behind reverse proxy (no trailing slash)
# Example: https://shop.example.com
PUBLIC_URL=

# --- Security (required in production) ---
# Generate: openssl rand -hex 32
SESSION_SECRET=
COOKIE_SECURE=0

# --- First-time admin seed (only when no admin exists in database) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password
ADMIN_NAME=Site Admin

# --- Optional paths (absolute or relative to process cwd) ---
# APP_ROOT=          # project root (default: parent of server.js/)
# FRONTEND_DIR=      # default: {APP_ROOT}/index.html
# SERVER_DIR=        # default: {APP_ROOT}/server.js
# DB_PATH=           # default: {SERVER_DIR}/ecom.db
# UPLOADS_DIR=       # default: {SERVER_DIR}/uploads
# BRANDING_UPLOADS_DIR=  # default: {FRONTEND_DIR}/uploads
# LOG_DIR=            # default: {APP_ROOT}/logs

# --- Optional tuning ---
# JSON_BODY_LIMIT=12mb
# PM2_APP_NAME=ecommerce
# PM2_MAX_MEMORY=512M

# --- Optional defaults (JSON array) when DB has no social_links ---
# DEFAULT_SOCIAL_LINKS_JSON=[]

# --- Local dev tunnel only (npm run tunnel) ---
# TUNNEL_TARGET_HOST=127.0.0.1

# --- CI / tests only ---
# TEST_BASE=http://127.0.0.1:3001
# TEST_ADMIN_PASSWORD=your-admin-password
