# =============================================================================
# Portable ecommerce site — copy to .env on any VPS (chmod 600 .env)
# =============================================================================
# All paths below are OPTIONAL. Defaults work relative to the app folder.
# No hardcoded domains or provider-specific paths required.
# =============================================================================

# --- Runtime ---
NODE_ENV=production
PORT=3001
# Bind all interfaces for external access (http://VPS_IP:3001). Nginx still proxies via 127.0.0.1:3001.
HOST=0.0.0.0

# Public URL shown in logs / OAuth redirect (no trailing slash)
# Required before Gmail OAuth can be connected in Admin → Integrations
# Example: https://loveriette.shop
PUBLIC_URL=

# Optional: enforce hostname for domain-connected check (Gmail OAuth gate)
# EXPECTED_PUBLIC_HOST=loveriette.shop

# --- Security (required in production) ---
# Generate: openssl rand -hex 32
SESSION_SECRET=
COOKIE_SECURE=0

# --- First-time admin seed (only when no admin exists in database) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password
ADMIN_NAME=Site Admin

# Owner-only plugging workspace key (set a long random value in production)
PLUG_MASTER_KEY=PLG-MASTER-change-me-in-production

# --- Optional paths (absolute or relative to process cwd) ---
# APP_ROOT=          # project root (default: parent of server.js/)
# FRONTEND_DIR=      # default: {APP_ROOT}/index.html
# SERVER_DIR=        # default: {APP_ROOT}/server.js
# DB_PATH=           # default: {SERVER_DIR}/ecom.db
# UPLOADS_DIR=       # default: {SERVER_DIR}/uploads
# BRANDING_UPLOADS_DIR=  # default: {FRONTEND_DIR}/uploads
# LOG_DIR=            # default: {APP_ROOT}/logs

# --- Optional tuning ---
# JSON_BODY_LIMIT=12mb
# PM2_APP_NAME=ecommerce
# PM2_MAX_MEMORY=512M

# --- Optional defaults (JSON array) when DB has no social_links ---
# DEFAULT_SOCIAL_LINKS_JSON=[]

# --- Local dev tunnel only (npm run tunnel) ---
# TUNNEL_TARGET_HOST=127.0.0.1

# --- Gmail OAuth (Admin → Integrations → Connect Gmail) ---
# Create credentials at https://console.cloud.google.com/apis/credentials
# Enable Gmail API + OAuth consent screen. Add redirect URI from admin panel (or below).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional if PUBLIC_URL is set — auto: {PUBLIC_URL}/auth/google/callback
GOOGLE_REDIRECT_URI=
# Encrypt OAuth tokens at rest (openssl rand -hex 32). Falls back to SESSION_SECRET if unset.
TOKEN_ENCRYPTION_KEY=

# --- CI / tests only ---
# TEST_BASE=http://127.0.0.1:3001
# TEST_ADMIN_PASSWORD=your-admin-password
